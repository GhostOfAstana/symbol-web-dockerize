# По умолчанию сервер работает на :8080.
ADDR=:8080
# Только для HTTP-монитора на Docker-хосте; в обычном контейнере оставить пустым.
MONITOR_CONTAINER=
# Без URL и модели текстовый помощник использует воспроизводимый mock-режим.
LLM_BASE_URL=
LLM_MODEL=
# Дополнительные настройки общего текстового помощника описаны в README.md.
